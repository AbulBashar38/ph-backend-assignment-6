model Property {
  id String @id @default(uuid(7))

  title        String
  description  String
  propertyType PropertyType
  address      String
  city         String
  area         String
  latitude     Float?
  longitude    Float?
  amenities    Amenity[]

  status         PropertyStatus @default(DRAFT)
  publishedAt    DateTime?
  // Listing becomes INACTIVE automatically after this date (cron, requirement §20)
  expiresAt      DateTime?
  // Set by admin moderation
  moderationNote String?
  moderatedAt    DateTime?

  // Search helpers, kept up to date by a database trigger on rooms (migration 20261005100000_search_and_occupancy):
  // live AVAILABLE rooms of this property, the cheapest of their rents, and the earliest date one can be moved into
  // (a past date = right away). 0 / null when no room is available.
  availableRoomCount    Int       @default(0)
  minAvailableRent      Int?
  earliestAvailableFrom DateTime?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // The owner's USER id (a user with role OWNER)
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  images PropertyImage[]
  rooms  Room[]

  viewingRequests ViewingRequest[]
  applications    Application[]
  rentals         Rental[]

  @@index([ownerId], name: "idx_property_ownerId")
  @@index([status, isDeleted], name: "idx_property_status_isDeleted")
  @@index([city, area], name: "idx_property_city_area")
  @@index([minAvailableRent], name: "idx_property_minAvailableRent")
  @@index([earliestAvailableFrom], name: "idx_property_earliestAvailableFrom")
  @@map("properties")
}

model PropertyImage {
  id String @id @default(uuid(7))

  url       String
  publicId  String
  createdAt DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([propertyId], name: "idx_propertyImage_propertyId")
  @@map("property_images")
}
