// One table for every role. Role-specific details are plain optional columns (few, so no separate profile tables).
model User {
  id                 String       @id @default(uuid(7))
  name               String
  email              String       @unique
  phone              String?      @unique
  password           String?
  googleId           String?      @unique
  authProvider       AuthProvider @default(CREDENTIAL)
  emailVerified      Boolean      @default(false)
  role               Role         @default(TENANT)
  status             UserStatus   @default(ACTIVE)
  needPasswordChange Boolean      @default(false)
  imageUrl           String?
  imagePublicId      String?

  // Profile details (tenant: gender, occupation; owner: address)
  gender     Gender?
  occupation String?
  address    String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Properties this user owns (role OWNER; enforced in services, not by the database)
  properties Property[]

  // Tenants looking for a roommate (optional, at most one)
  roommateProfile RoommateProfile?

  viewingRequests ViewingRequest[]
  applications    Application[]
  tenantRentals   Rental[]         @relation("RentalTenant")
  ownerRentals    Rental[]         @relation("RentalOwner")
  payments        Payment[]
  notifications   Notification[]

  @@index([role], name: "idx_user_role")
  @@index([status], name: "idx_user_status")
  @@map("users")
}
