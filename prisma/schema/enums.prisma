enum Role {
  SUPER_ADMIN
  ADMIN
  OWNER
  TENANT
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum AuthProvider {
  GOOGLE
  CREDENTIAL
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PropertyType {
  APARTMENT
  HOUSE
  HOSTEL
  SUBLET
  STUDIO
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  INACTIVE
  SUSPENDED
  ARCHIVED
}

// Shared by properties and (later) rooms, so search filters match exactly
enum Amenity {
  WIFI
  AC
  PARKING
  LIFT
  GENERATOR
  GAS
  CCTV
  SECURITY_GUARD
  FURNISHED
  WATER_SUPPLY
  KITCHEN
  LAUNDRY
  BALCONY
  ROOFTOP
  ATTACHED_BATHROOM
}

enum RoomType {
  SINGLE
  SHARED
  MASTER
  STUDIO
}

// AVAILABLE / UNAVAILABLE / MAINTENANCE are set by the owner (or an admin).
// RESERVED / OCCUPIED are set only by the system (application approved / rent paid).
enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  UNAVAILABLE
  MAINTENANCE
}

// Roommate preferences for smoking / pets:
// YES = "I smoke (have pets) or I'm fine with it", NO = "please no", NO_PREFERENCE = "don't mind"
enum Preference {
  YES
  NO
  NO_PREFERENCE
}

enum SleepSchedule {
  EARLY_BIRD
  NIGHT_OWL
  FLEXIBLE
}

// Fixed list so roommate matching can compare lifestyles reliably
enum LifestyleTag {
  QUIET
  SOCIAL
  CLEAN
  STUDIOUS
  WORK_FROM_HOME
  FITNESS
  COOKING
  GAMING
  MUSIC
  VEGETARIAN
  RELIGIOUS
  PARTY
}

enum AuditAction {
  USER_UPDATED
  USER_DELETED
  PROPERTY_CREATED
  PROPERTY_UPDATED
  PROPERTY_PUBLISHED
  PROPERTY_DISABLED
  PROPERTY_ARCHIVED
  PROPERTY_SUSPENDED
  PROPERTY_RESTORED
  ROOM_CREATED
  ROOM_UPDATED
  ROOM_STATUS_CHANGED
  ROOM_ARCHIVED
}
