// In-app notification for one user (requirement §17). Created in the same transaction as the event.
model Notification {
  id String @id @default(uuid(7))

  type    NotificationType
  title   String
  message String
  // Ids the frontend needs to link to, e.g. { "viewingRequestId": "…", "propertyId": "…" }
  data    Json?

  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, isRead, createdAt], name: "idx_notification_user_read_created")
  @@map("notifications")
}
