<%- include('partials/layout-start', {
  title: `You're now an admin`,
  preheader: `${createdBy} added you as an administrator of ${appName}.`,
}) %>
<%- include('partials/heading', { text: `You're now an admin` }) %>
<p style="margin: 0 0 12px 0;">Hi <%= name %>,</p>
<p style="margin: 0 0 20px 0;">
  <%= createdBy %> created an administrator account for you on <%= appName %>. You can manage users, moderate listings,
  and follow rentals and payments across the platform.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 4px 0; border: 1px solid #e2e8f0; border-radius: 10px;">
  <tr>
    <td style="padding: 12px 16px; font-size: 13px; line-height: 20px; color: #64748b;">Login email</td>
    <td align="right" style="padding: 12px 16px; font-size: 13px; line-height: 20px; color: #0f172a; font-weight: 600;"><%= email %></td>
  </tr>
</table>

<%- include('partials/button', { href: `${frontendUrl}/login`, label: 'Log in' }) %>

<%- include('partials/callout', {
  tone: 'warning',
  title: 'Your temporary password',
  text: `${createdBy} will share it with you separately (it's never sent by email). You'll be asked to choose a new password after your first login.`,
}) %>
<%- include('partials/layout-end') %>
