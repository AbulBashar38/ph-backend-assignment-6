<%- include('partials/layout-start', {
  title: 'Verify your email',
  preheader: `Your ${appName} verification code is ${otp}. It expires in ${expirationMinutes} minutes.`,
}) %>
<%- include('partials/heading', { text: 'Verify your email' }) %>
<p style="margin: 0 0 12px 0;">Hi <%= name %>,</p>
<p style="margin: 0;">
  Thanks for signing up with <strong style="color: #0f172a;"><%= email %></strong>.
  Enter the code below to confirm it's you and finish creating your account.
</p>

<%- include('partials/otp-code', { otp, expirationMinutes }) %>

<%- include('partials/callout', {
  tone: 'info',
  title: 'Keep this code private',
  text: `${appName} will never ask for this code by phone, chat, or email. If you didn't sign up, you can safely ignore this message.`,
}) %>
<%- include('partials/layout-end') %>
