<%#
  Highlighted note. tone: 'info' (default) | 'warning'
    include('partials/callout', { tone, title, text })
-%>
<% const isWarning = typeof tone !== 'undefined' && tone === 'warning' -%>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 8px 0 4px 0;">
  <tr>
    <td style="background-color: <%= isWarning ? '#fffbeb' : '#f8fafc' %>; border-left: 4px solid <%= isWarning ? '#f59e0b' : '#94a3b8' %>; border-radius: 8px; padding: 14px 16px; font-size: 13px; line-height: 20px; color: <%= isWarning ? '#78350f' : '#475569' %>;">
      <strong style="color: <%= isWarning ? '#92400e' : '#334155' %>;"><%= title %></strong><br />
      <%= text %>
    </td>
  </tr>
</table>
