<%
  const isOwner = role === 'OWNER'
  const steps = isOwner
    ? [
        ['List your property', 'Add the address, photos, and amenities so tenants know what to expect.'],
        ['Add rooms and set rent', 'Create each room with its monthly rent, capacity, and availability date.'],
        ['Review requests', 'Approve viewings and applications, then collect rent securely online.'],
      ]
    : [
        ['Search rooms', 'Filter by city, area, budget, room type, and amenities.'],
        ['Find a roommate', 'Create your roommate profile and see how compatible you are with others.'],
        ['Visit and apply', 'Request a viewing, apply in a few clicks, and pay rent online.'],
      ]
-%>
<%- include('partials/layout-start', {
  title: `Welcome to ${appName}`,
  preheader: isOwner
    ? 'Your owner account is ready. List your first property in minutes.'
    : 'Your account is ready. Start searching for your next home.',
}) %>
<%- include('partials/heading', { text: `Welcome, ${name}!` }) %>
<p style="margin: 0 0 24px 0;">
  <% if (isOwner) { %>
    Your owner account is ready. Here's how to get your first tenants:
  <% } else { %>
    Your account is ready. Here's how to find your next home:
  <% } %>
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <% steps.forEach(([stepTitle, stepText], index) => { %>
  <tr>
    <td width="40" valign="top" style="padding: 0 0 18px 0;">
      <div style="width: 28px; height: 28px; border-radius: 14px; background-color: #ccfbf1; color: #0f766e; font-size: 13px; font-weight: 700; line-height: 28px; text-align: center;"><%= index + 1 %></div>
    </td>
    <td valign="top" style="padding: 3px 0 18px 0;">
      <div style="font-size: 15px; line-height: 22px; font-weight: 700; color: #0f172a;"><%= stepTitle %></div>
      <div style="font-size: 14px; line-height: 21px; color: #64748b;"><%= stepText %></div>
    </td>
  </tr>
  <% }) %>
</table>

<%- include('partials/button', {
  href: frontendUrl,
  label: isOwner ? 'List your first property' : 'Start searching',
}) %>

<p style="margin: 0; font-size: 13px; line-height: 20px; color: #64748b;">
  Signed up as <strong style="color: #334155;"><%= isOwner ? 'a property owner' : 'a tenant' %></strong> with <%= email %>.
</p>
<%- include('partials/layout-end') %>
