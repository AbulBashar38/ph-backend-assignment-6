<%- include('partials/layout-start', {
  title: 'Roommate connection',
  preheader: `You and ${otherName} are now connected. Here's how to reach them.`,
}) %>
<%- include('partials/heading', { text: `You're connected with ${otherName}` }) %>
<p style="margin: 0 0 12px 0;">Hi <%= name %>,</p>
<p style="margin: 0 0 20px 0;">
  Good news: you and <strong style="color: #0f172a;"><%= otherName %></strong> both agreed to connect as potential
  roommates. Here are their contact details:
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 4px 0; border: 1px solid #e2e8f0; border-radius: 10px;">
  <% const rows = [['Name', otherName], ['Email', otherEmail], ['Phone', otherPhone || 'Not provided']] -%>
  <% rows.forEach(([label, value], index) => { const border = index < rows.length - 1 ? 'border-bottom: 1px solid #e2e8f0;' : '' -%>
  <tr>
    <td style="padding: 12px 16px; font-size: 13px; line-height: 20px; color: #64748b; <%= border %>"><%= label %></td>
    <td align="right" style="padding: 12px 16px; font-size: 13px; line-height: 20px; color: #0f172a; font-weight: 600; <%= border %>"><%= value %></td>
  </tr>
  <% }) -%>
</table>

<%- include('partials/button', { href: `${frontendUrl}/dashboard/roommate/connections`, label: 'View your connections' }) %>

<%- include('partials/callout', {
  tone: 'warning',
  title: 'Stay safe',
  text: 'Meet in a public place first, and never send money before you have seen the room and signed with the owner on the platform.',
}) %>
<%- include('partials/layout-end') %>
