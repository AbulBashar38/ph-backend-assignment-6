<% const dueIn = daysLeft === 1 ? 'tomorrow' : `in ${daysLeft} days` -%>
<%- include('partials/layout-start', {
  title: 'Rent due soon',
  preheader: `Your rent payment of ${amount} is due ${dueIn} (${dueDate}).`,
}) %>
<%- include('partials/heading', { text: `Your rent is due ${dueIn}` }) %>
<p style="margin: 0 0 12px 0;">Hi <%= name %>,</p>
<p style="margin: 0 0 20px 0;">
  This is a friendly reminder that your rent payment of <strong><%= amount %></strong> is due on <strong><%= dueDate %></strong>.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 4px 0; border: 1px solid #e2e8f0; border-radius: 10px;">
  <% const rows = [
    ['Amount', amount],
    ['Due date', dueDate],
    ['Property', propertyTitle],
    ['Room', roomName],
    ['Period', period],
  ] -%>
  <% rows.forEach(([label, value], index) => { const border = index < rows.length - 1 ? 'border-bottom: 1px solid #e2e8f0;' : '' -%>
  <tr>
    <td style="padding: 12px 16px; font-size: 13px; line-height: 20px; color: #64748b; <%= border %>"><%= label %></td>
    <td align="right" style="padding: 12px 16px; font-size: 13px; line-height: 20px; color: #0f172a; font-weight: 600; <%= border %>"><%= value %></td>
  </tr>
  <% }) -%>
</table>

<%- include('partials/button', { href: `${frontendUrl}/dashboard/payments`, label: 'Pay rent now' }) %>

<%- include('partials/callout', {
  title: 'Already paid?',
  text: 'If you paid in the last few minutes, you can ignore this email. Your receipt is sent as soon as the payment is confirmed.',
}) %>
<%- include('partials/layout-end') %>
