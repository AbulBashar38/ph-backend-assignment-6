<%- include('partials/layout-start', {
  title: 'Your password was changed',
  preheader: `The password for your ${appName} account was changed on ${changedAt}.`,
}) %>
<%- include('partials/heading', { text: 'Your password was changed' }) %>
<p style="margin: 0 0 12px 0;">Hi <%= name %>,</p>
<p style="margin: 0 0 20px 0;">
  The password for your account was reset successfully. For your security, we've signed you out on all devices.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 4px 0; border: 1px solid #e2e8f0; border-radius: 10px;">
  <tr>
    <td style="padding: 12px 16px; font-size: 13px; line-height: 20px; color: #64748b; border-bottom: 1px solid #e2e8f0;">Account</td>
    <td align="right" style="padding: 12px 16px; font-size: 13px; line-height: 20px; color: #0f172a; font-weight: 600; border-bottom: 1px solid #e2e8f0;"><%= email %></td>
  </tr>
  <tr>
    <td style="padding: 12px 16px; font-size: 13px; line-height: 20px; color: #64748b;">Changed</td>
    <td align="right" style="padding: 12px 16px; font-size: 13px; line-height: 20px; color: #0f172a; font-weight: 600;"><%= changedAt %></td>
  </tr>
</table>

<%- include('partials/button', { href: `${frontendUrl}/login`, label: 'Log in with your new password' }) %>

<%- include('partials/callout', {
  tone: 'warning',
  title: "Wasn't you?",
  text: 'Reset your password again right away using "Forgot password" on the login page, and reply to this email so we can help secure your account.',
}) %>
<%- include('partials/layout-end') %>
