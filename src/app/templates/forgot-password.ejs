<%- include('partials/layout-start', {
  title: 'Reset your password',
  preheader: `Your password reset code is ${otp}. It expires in ${expirationMinutes} minutes.`,
}) %>
<%- include('partials/heading', { text: 'Reset your password' }) %>
<p style="margin: 0 0 12px 0;">Hi <%= name %>,</p>
<p style="margin: 0;">
  We received a request to reset the password for your <%= appName %> account.
  Use this code to choose a new password.
</p>

<%- include('partials/otp-code', { otp, expirationMinutes }) %>

<%- include('partials/callout', {
  tone: 'warning',
  title: "Didn't request this?",
  text: 'You can ignore this email and your password will stay the same. Never share this code with anyone.',
}) %>
<%- include('partials/layout-end') %>
