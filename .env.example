NODE_ENV=development
PORT=5050

# Used to build absolute links back to this API
# Live (production): https://ph-backend-assignment-6.vercel.app
BACKEND_URL=http://localhost:5000
# Allowed CORS origin for the browser client
FRONTEND_URL=http://localhost:3000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/housing_roommate?schema=public"

# Generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_random_64_char_hex_string
JWT_REFRESH_SECRET=replace_with_a_different_random_64_char_hex_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Must be the same client ID the frontend uses to get the Google ID token.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Created on first boot if no super admin exists
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=Change_Me_123!

# Redis (local: leave user/password empty; Redis Cloud: copy from the dashboard)
REDIS_USER=
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

# Gmail SMTP with an App Password (Google Account > Security > App passwords)
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_app_password
EMAIL_SENDER="Housing & Roommate Platform <your_gmail_address@gmail.com>"

# Cloudinary (Dashboard > Product environment credentials)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe (Dashboard > Developers > API keys; use the TEST mode key sk_test_… while developing).
# Webhook secret: `stripe listen --forward-to localhost:<PORT>/api/v1/payment/webhook` prints a whsec_… for local use;
# in production, create an endpoint for /api/v1/payment/webhook in the Dashboard and copy its signing secret.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Days a pending rental application stays open before it expires
APPLICATION_EXPIRY_DAYS=7

# Swagger is always on outside production; set to true to enable it in production
SWAGGER_ENABLED=false

# Background jobs (rent bills, reminders, expiries, payment reconciliation). Set to false to turn them off on this
# instance. With several instances they can all stay on: a Redis lock lets only one run each job.
CRON_ENABLED=true
